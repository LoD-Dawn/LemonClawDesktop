{
  "appId": "com.diclaw.app",
  "productName": "LemonClaw",
  "executableName": "LemonClaw",
  "directories": {
    "output": "release"
  },
  "beforePack": "./scripts/electron-builder-hooks.cjs",
  "afterPack": "./scripts/electron-builder-hooks.cjs",
  "files": [
    "sandbox/agent-runner/AGENT_SYSTEM_PROMPT.md",
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*"]
    },
    {
      "from": "dist-electron",
      "to": "dist-electron",
      "filter": ["**/*"]
    }
  ],
  "extraResources": [
    {
      "from": "resources/tray",
      "to": "tray",
      "filter": [
        "**/*"
      ]
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "build/icons/mac/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "CFBundleIconName": "icon",
      "NSCalendarsUsageDescription": "LemonClaw 需要访问您的日历来帮助您查看和管理日程安排，例如查找事件、创建会议等。",
      "NSRemindersUsageDescription": "LemonClaw 需要访问您的提醒事项来帮助您管理待办事项。",
      "NSAppleEventsUsageDescription": "LemonClaw 需要使用 Apple Events 来控制 Calendar 应用执行自动化操作。",
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "com.diclaw.app",
          "CFBundleURLSchemes": ["diclaw"]
        }
      ]
    },
    "extraResources": [
      {
        "from": "SKILLs",
        "to": "SKILLs",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/.venv",
          "!**/.venv/**"
        ]
      },
      {
        "from": "vendor/openclaw-runtime/current",
        "to": "cfmind",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dmg": {
    "sign": false
  },
  "afterSign": "scripts/notarize.js",
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icons/win/icon.ico",
    "requestedExecutionLevel": "requireAdministrator",
    "protocols": [
      {
        "name": "LemonClaw Protocol",
        "schemes": ["diclaw"]
      }
    ],
    "extraResources": [
      {
        "from": "resources/mingit",
        "to": "mingit",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-tar/win-resources.tar",
        "to": "win-resources.tar"
      },
      {
        "from": "scripts/unpack-cfmind.cjs",
        "to": "unpack-cfmind.cjs"
      }
    ]
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "build/icons/png",
    "category": "Utility",
    "extraResources": [
      {
        "from": "SKILLs",
        "to": "SKILLs",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/.venv",
          "!**/.venv/**"
        ]
      },
      {
        "from": "vendor/openclaw-runtime/current",
        "to": "cfmind",
        "filter": [
          "**/*"
        ]
      }
    ],
    "desktop": {
      "Name": "LemonClaw",
      "Comment": "AI-assisted coding and productivity tool",
      "Terminal": "false"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": true,
    "include": "scripts/nsis-installer.nsh"
  },
  "electronVersion": "40.2.1",
  "asarUnpack": [
    "node_modules/@anthropic-ai/claude-agent-sdk/**",
    "node_modules/@img/**",
    "node_modules/sql.js/dist/**",
    "node_modules/node-nim/**",
    "node_modules/npm/**"
  ],
  "asar": true
}
